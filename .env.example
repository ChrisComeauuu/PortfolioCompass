# Copy to .env for local dev (never commit .env)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the SnapTrade dashboard
REDIRECT_URI=http://localhost:3000/auth/callback
PORT=3000

# Optional: enables market data for the Head to head card (free key from alphavantage.co).
# The free plan allows about 25 lookups a day; results are cached for 12 hours.
ALPHAVANTAGE_KEY=
